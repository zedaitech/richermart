# Copy to .env for local development with `netlify dev`.
# In production, set these in Netlify → Site settings → Environment variables.

# Neon pooled connection string (from neon.tech project dashboard)
DATABASE_URL=postgres://user:pass@ep-xyz-pooler.neon.tech/neondb?sslmode=require

# Admin sign-in password
ADMIN_PASSWORD=change-me

# Random 32+ char secret used to sign admin session tokens
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-or-more-random-characters
